# Backend Environment Variables
APP_NAME="Dam Break Inundation Modelling System"
APP_ENV="development"
DEBUG=True
HOST="127.0.0.1"
PORT=8000

# Database Configuration
# Uses local SQLite by default, seamlessly supports PostgreSQL + PostGIS in production
# Example PostGIS: postgresql://postgres:password@localhost:5432/dam_break_db
DATABASE_URL="sqlite:///./data/dam_break.db"

# Storage Directories
DATA_DIR="./data"
MODELS_DIR="./models"
SIMULATIONS_DIR="./data/simulations"

# External Hydrodynamic Engine Configuration
# Provide absolute path to d_flow.exe or dimr if installed
DELFT3D_PATH=""
DELFT3D_WORKING_DIR="./data/delft3d_runs"

# Earth Engine Credentials (optional)
GEE_PROJECT_ID=""
GEE_SERVICE_ACCOUNT_JSON=""

# OpenTopography API Key (optional for higher rate limits)
OPENTOPOGRAPHY_API_KEY=""
